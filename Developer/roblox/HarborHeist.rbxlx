questList.Position = UDim2.new(0, 14, 0, 52)
questList.BackgroundTransparency = 1
questList.ScrollBarThickness = 6
questList.CanvasSize = UDim2.new(0, 0, 0, 0)
questList.AutomaticCanvasSize = Enum.AutomaticSize.Y
