if Anim and type(Anim.swipeDismiss) == "function" then
	pcall(function()
		Anim:swipeDismiss(aquariumPanel, hidePanels)
		Anim:swipeDismiss(inventoryPanel, hidePanels)
		Anim:swipeDismiss(shopPanel, hidePanels)
